{
  "name": "auth-module",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "pretypecheck": "npm run build -w @auth-module/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build -w @auth-module/shared",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "~5.0.5"
  }
}
