    { "type": "rectangle", "id": "users_card", "x": 40, "y": 328, "width": 330, "height": 168, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 161, "version": 1, "versionNonce": 261, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "users_text", "x": 56, "y": 340, "width": 300, "height": 144, "text": "users\npasswordHash    argon2id\n                select: false\nemail           unique\nsessionVersion  in every JWT\nfailedLogins    lock at 5\ncodeFailures    10 per 24 h", "originalText": "users\npasswordHash    argon2id\n                select: false\nemail           unique\nsessionVersion  in every JWT\nfailedLogins    lock at 5\ncodeFailures    10 per 24 h", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 162, "version": 1, "versionNonce": 262, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "sessions_card", "x": 405, "y": 328, "width": 330, "height": 168, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 171, "version": 1, "versionNonce": 271, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "sessions_text", "x": 421, "y": 340, "width": 300, "height": 144, "text": "sessions\ntokenHash       sha256\nfamilyId        one per device\nsessionVersion  at issue time\nusedAt          set on refresh\n\nreuse revokes the family", "originalText": "sessions\ntokenHash       sha256\nfamilyId        one per device\nsessionVersion  at issue time\nusedAt          set on refresh\n\nreuse revokes the family", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 172, "version": 1, "versionNonce": 272, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "codes_card", "x": 770, "y": 328, "width": 330, "height": 168, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 181, "version": 1, "versionNonce": 281, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "codes_text", "x": 786, "y": 340, "width": 300, "height": 144, "text": "one_time_codes\ncodeHash   HMAC-SHA256\nattempts   dead at 5\nexpiresAt  10 min\n\none live code per user\nand type (verify, reset)", "originalText": "one_time_codes\ncodeHash   HMAC-SHA256\nattempts   dead at 5\nexpiresAt  10 min\n\none live code per user\nand type (verify, reset)", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 182, "version": 1, "versionNonce": 282, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

