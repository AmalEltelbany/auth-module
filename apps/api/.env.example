# Copy to apps/api/.env for local development.
NODE_ENV=development
PORT=3001

# docker compose up mongo  →  single-node replica set
MONGO_URI=mongodb://localhost:27017/auth-module?replicaSet=rs0&directConnection=true

# At least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-48-bytes

# docker compose up mailpit  →  inbox at http://localhost:8025
# Leave SMTP_HOST empty to log mail to the console instead (not allowed in production).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Auth Module <no-reply@auth-module.local>
